APP_ENV="staging"

DATABASE_URL="postgres://3s_design:change-this-long-random-password@staging-postgres:5432/3s_design"
REDIS_URL="redis://staging-redis:6379"

JWT_ACCESS_SECRET="change-this-64-plus-char-random-staging-secret-before-deploy"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

OPENAI_API_KEY="change-this-openai-api-key"
OPENAI_AI_DISCOVERY_MODEL="gpt-5.4-mini"

R2_ACCOUNT_ID="change-this-r2-account-id"
R2_ACCESS_KEY_ID="change-this-r2-access-key-id"
R2_SECRET_ACCESS_KEY="change-this-r2-secret-access-key"
R2_BUCKET_NAME="3s-design-staging"
R2_PUBLIC_BASE_URL="https://staging-assets.3s-design.example"
R2_SIGNED_UPLOAD_TTL_SECONDS="300"
R2_SIGNED_DOWNLOAD_TTL_SECONDS="300"
R2_REQUIRE_UPLOAD_CHECKSUM="true"

PAYMENT_WEBHOOK_SECRET_MANUAL="change-this-manual-webhook-secret"
PAYMENT_PENDING_EXPIRY_MINUTES="120"
PAYMENT_PENDING_EXPIRY_MINUTES_MANUAL="2880"

PAYMOB_API_KEY="change-this-paymob-api-key"
PAYMOB_API_BASE_URL="https://accept.paymob.com/api"
PAYMOB_INTEGRATION_ID_CARD="change-this-paymob-card-integration-id"
PAYMOB_IFRAME_ID="change-this-paymob-iframe-id"
PAYMOB_HMAC_SECRET="change-this-paymob-hmac-secret"
PAYMOB_PAYMENT_KEY_TTL_SECONDS="3600"

PAYPAL_CHECKOUT_URL_TEMPLATE="https://paypal.example/checkout/{orderId}"
PAYMENT_WEBHOOK_SECRET_PAYPAL="change-this-paypal-webhook-secret"

FAWRY_CHECKOUT_URL_TEMPLATE="https://fawry.example/checkout/{orderId}"
PAYMENT_WEBHOOK_SECRET_FAWRY="change-this-fawry-webhook-secret"

SENTRY_DSN=""
SENTRY_ENVIRONMENT="staging"
SENTRY_REPLAY_ERROR_SAMPLE_RATE="1.0"
SENTRY_REPLAY_SESSION_SAMPLE_RATE="0.05"

ADMIN_SEED_CONFIRM="CREATE_3S_DESIGN_ADMIN"
ADMIN_EMAIL="admin@staging.3s-design.example"
ADMIN_FULL_NAME="3S Design Admin"
ADMIN_PASSWORD="change-this-before-first-staging-deploy"
